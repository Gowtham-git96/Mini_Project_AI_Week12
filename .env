# MP3 environment configuration
# ---------------------------------------------------------------
# Copy this file to .env and fill in the real values.
#
# The script auto-loads .env via python-dotenv, so you do NOT need
# `source .env` and you do NOT need the `export` keyword. Just plain
# KEY=value lines.

# ─── OpenAI / Vocareum ────────────────────────────────────────
# Your Vocareum-issued key:
OPENAI_API_KEY="voc-108404801721403752289126acb836e9feb06.40143117"

# Vocareum proxies the OpenAI API through a custom base URL. Set it here.
# (Use the base URL from your Vocareum lab — commonly ends in /v1)
OPENAI_BASE_URL="https://openai.vocareum.com/v1"

# ─── Qdrant Cloud free tier (recommended) ─────────────────────
#   https://cloud.qdrant.io/ → create cluster → copy URL + API key
QDRANT_URL="https://d31bc0a7-ed02-4bdf-bfee-c3701cac60de.sa-east-1-0.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6OTUzNGFmOTMtNzY2NS00YTNkLWIwNjAtZTY3MTE5MDM0MDU4In0.1aAmMM9qs15zswjZqDfoOympjKlsyUUX1wTiwzMFAlg"

# ─── Local Qdrant alternative ─────────────────────────────────
# If you'd rather run Qdrant locally via Docker:
#     docker run -p 6333:6333 -v $(pwd)/qdrant_storage:/qdrant/storage qdrant/qdrant
# then use:
#     QDRANT_URL="http://localhost:6333"
#     (leave QDRANT_API_KEY unset / commented out)

# ─── Optional tuning (sensible defaults apply if unset) ───────
# Seconds to wait for Qdrant — raise this if the cloud cluster is slow to respond:
# QDRANT_TIMEOUT="30"
# Abstention cutoff — lower it if a valid question wrongly abstains, raise it to be stricter:
# RETRIEVAL_THRESHOLD="0.30"
